# Local environments and secrets
.venv/
venv/
.env
.env.*
!.env.example
**/.streamlit/secrets.toml

# Python cache and compiled files
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Local vector database
.qdrant/

# Data and model files (handled externally or via Git LFS if needed)
*.csv
*.npz
*.h5
*.pt
*.onnx
*.zip

# Raw third-party data and generated output. The official FIA regulation PDFs in
# data/fia_docs are included (README: "Acknowledgements"); the downloader's
# staging files are not.
data/*
!data/fia_docs/
data/fia_docs/.download-*/
data/fia_docs/.manifest-*
outputs/

# OS/editor noise
.DS_Store
.vscode/
.idea/

# Embedding cache (provider vectors keyed by model + text hash)
.cache/
