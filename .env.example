# Copy to .env (git-ignored). Values in the real environment take precedence over .env.

# ---------------------------------------------------------------- API server
# HOST/PORT apply to `python -m app.main` / `python app/main.py`; with uvicorn use --host/--port.
HOST=127.0.0.1
PORT=8000
# Set to 0 to ignore this .env file (the test suite does this).
F1_COPILOT_LOAD_DOTENV=1
# Comma-separated origins, or * for any origin (credentials are never allowed with *).
CORS_ORIGINS=*
# Generated ghost-comparison images are written to <F1_ARTIFACTS_DIR>/ghost and served under /artifacts/ghost.
F1_ARTIFACTS_DIR=outputs

# ---------------------------------------------------------------- Web UI
# Where the Streamlit UI finds the API (environment first, then only this key from .env).
# scripts/run_app.py sets it itself; http://user:password@host:port works for an API behind an auth proxy.
F1_API_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------- FIA RAG model provider
# Any OpenAI-compatible endpoint. Leave OPENAI_BASE_URL empty for api.openai.com.
OPENAI_API_KEY=
OPENAI_BASE_URL=
FIA_RAG_EMBEDDING_MODEL=text-embedding-3-small
FIA_RAG_MODEL=gpt-4o-mini
# Example for OpenRouter's free tier (50 requests/day; each embedding batch counts as one request,
# so also set FIA_RAG_EMBEDDING_BATCH_SIZE=256 below):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# FIA_RAG_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# FIA_RAG_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
FIA_RAG_TIMEOUT_SECONDS=120
FIA_RAG_MAX_RETRIES=2

# ---------------------------------------------------------------- FIA RAG pipeline
FIA_DOCS_PATH=data/fia_docs
FIA_RAG_CHUNK_SIZE=1000
FIA_RAG_CHUNK_OVERLAP=200
FIA_RAG_EMBEDDING_BATCH_SIZE=128
FIA_RAG_TOP_K=8
# Minimum cosine similarity for a passage to count as evidence; calibrate per embedding model
# with `python scripts/check_fia_rag.py --calibrate`. 0.30 was calibrated for nemotron-3-embed-1b
# (answerable questions scored >= 0.50, off-topic ones <= 0.27).
FIA_RAG_MIN_SCORE=0.30
# Official definitions of defined terms (e.g. "TTCS") used by the retrieved passages that are
# added to the evidence (0 disables; the glossary is built by scripts/build_fia_index.py).
FIA_RAG_MAX_DEFINITIONS=3
FIA_RAG_TEMPERATURE=0
# Second model call that checks every sentence of an accepted answer against the excerpts it
# cites; declines unsupported answers (unverified_claim). Doubles chat requests per answer.
FIA_RAG_VERIFY_CLAIMS=false
# Optional cap on the answer length in tokens (a truncated answer is always declined).
FIA_RAG_MAX_OUTPUT_TOKENS=
# Reuse provider vectors for identical text and model ("off" disables).
FIA_RAG_EMBEDDING_CACHE=.cache/fia_embeddings.sqlite3

# ---------------------------------------------------------------- Driver-radio transcription (optional)
# Official Whisper model name (tiny, base, small, turbo, ...); empty means base. File paths are not supported.
WHISPER_MODEL=
# Model download/cache directory; empty means ~/.cache/whisper. Must be writable (or already hold the model).
WHISPER_CACHE_DIR=

# ---------------------------------------------------------------- Qdrant
# Leave QDRANT_URL empty for embedded local storage at QDRANT_PATH (single process only).
# For several processes run `docker compose up -d --wait qdrant` and set QDRANT_URL=http://127.0.0.1:6333.
# A QDRANT_API_KEY must not contain '$' unless single-quoted (Compose would expand it; see docker-compose.yml).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=.qdrant
FIA_RAG_COLLECTION=fia_regulations
